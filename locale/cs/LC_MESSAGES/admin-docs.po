msgstr "``profile``"

#: ../channels/microsoft365-graph/accounts.rst:81
msgid "``Mail.ReadWrite``"
msgstr "``Mail.ReadWrite``"

#: ../channels/microsoft365-graph/accounts.rst:82
msgid "``Mail.Send``"
msgstr "``Mail.Send``"

#: ../channels/microsoft365-graph/accounts.rst:83
msgid "``Mail.ReadWrite.Shared``"
msgstr "``Mail.ReadWrite.Shared``"

#: ../channels/microsoft365-graph/accounts.rst:84
msgid "``Mail.Send.Shared``"
msgstr "``Mail.Send.Shared``"

#: ../channels/microsoft365-graph/accounts.rst:86
#: ../channels/microsoft365/accounts/register-app.rst:89
