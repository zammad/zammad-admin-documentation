#: ../misc/object-conditions/basics.rst:0
msgid "**starts with one of**:"
msgstr "**začíná některým z**:"

#: ../misc/object-conditions/basics.rst:0
msgid "Matches if text starts with one of given tokens."
msgstr "Splněno, pokud text začíná některým ze zadaných tokenů."

#: ../misc/object-conditions/basics.rst:0
msgid "**ends with one of**:"
msgstr "**končí některým z**:"

#: ../misc/object-conditions/basics.rst:0
msgid "Matches if text ends with one of given tokens."
msgstr "Splněno, pokud text končí některým ze zadaných tokenů."

#: ../misc/object-conditions/basics.rst:0
msgid "**matches regex**:"
msgstr "**odpovídá regulárnímu výrazu**:"

