msgstr "**je některý z**:"

#: ../misc/object-conditions/basics.rst:0
msgid "Matches if text is equal to any of given tokens."
msgstr "Splněno, pokud se text rovná některému ze zadaných tokenů."

#: ../misc/object-conditions/basics.rst:0
msgid "**is none of**:"
msgstr "**není žádný z**:"

